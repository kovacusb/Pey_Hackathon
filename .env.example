# Aquí solo van los NOMBRES de las variables. Los VALORES se guardan como secretos (Render, Codespaces o .env local). Nunca en el repo.
# En GitHub ya están como secretos del repo (Codespaces y Actions): para actualizarlos, llena .env y corre scripts/cargar_secretos.sh.
# apps/api lee este archivo desde la raíz (../../.env).

# --- pey (portal.mipey.mx → Desarrollador → "Crear API Key"). Solo existe producción: todo cobro es real (pey/02, K03.3). ---
PEY_API_KEY=
# Secreto de firma del webhook: engrane de la llave → "Crear Webhook" con URL https://<dominio>/api/webhook-pey (pey/09, K03.5).
PEY_WEBHOOK_SECRET=

# --- Tope de cobro en pesos que impone el servidor (decisión propia, no es límite de pey; K03.7). ---
MAX_MONTO_MXN=500
# Servicios y recargas: monto real que se cobra en la demo sin importar el monto del recibo (0 = cobrar el monto real, hasta el tope).
DEMO_COBRO_MXN=0
# Servicios y recargas: 1 = SIMULACIÓN completa (sin cobro en pey) mientras no haya agregador; 0 = cobro CoDi real.
SERVICIOS_SIMULADOS=1

# --- WhatsApp Cloud API de Meta (apps/api/README.md). Un token temporal dura ~24 h (⚪). ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings → Basic → App secret: con él se verifica la firma X-Hub-Signature-256 de cada webhook.
WHATSAPP_APP_SECRET=
# Lo inventas tú (openssl rand -hex 16) y pones el mismo valor en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Opcional: versión de la Graph API (por defecto v27.0).
WHATSAPP_GRAPH_VERSION=

# --- Servidor (opcionales) ---
PORT=3000
# Chat de pruebas en /dev y pagos simulados (marcados SIMULACIÓN). 1 = encendido. En producción, apagado salvo que se pida.
DEV_TOOLS=1
# Clave para abrir /dev desde fuera de tu máquina (túnel o Render): https://<url>/dev/?clave=<DEV_CLAVE>. Mínimo 12 caracteres; vacía = solo local.
DEV_CLAVE=
# Clave para abrir el panel del negocio desde fuera: https://<url>/panel/?clave=<PANEL_CLAVE>. Mínimo 12 caracteres; vacía = solo local.
PANEL_CLAVE=
# SQLite (relativo a apps/api).
DB_PATH=data/pey.sqlite

# --- Facturación (módulo 3). Sin usuario y clave, las facturas son SIMULACIÓN (PDF sin validez fiscal). ---
# Cuenta de Facturama (API Web). Sandbox: https://apisandbox.facturama.mx (por defecto); producción: https://api.facturama.mx
FACTURAMA_USUARIO=
FACTURAMA_CLAVE=
FACTURAMA_URL=
# Código postal del lugar de expedición (el del emisor configurado en Facturama).
FACTURAMA_LUGAR_EXPEDICION=

# --- Claude, para el agente (tarea 4 del PRD): Claude Console → API keys. ---
ANTHROPIC_API_KEY=
