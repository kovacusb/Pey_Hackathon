# Aquí solo van los NOMBRES de las variables. Los VALORES se guardan como secretos (Vercel, Codespaces o .env local). Nunca en el repo.

# --- pey (portal.mipey.mx → Desarrollador → "Crear API Key"). Solo existe producción: todo cobro es real (pey/02, K03.3). ---
PEY_API_KEY=
# Secreto de firma del webhook: engrane de la llave → "Crear Webhook". Un webhook por llave (pey/09, K03.5).
PEY_WEBHOOK_SECRET=

# --- Tope de cobro en pesos que impone el servidor (decisión propia, no es límite de pey; K03.7). En pruebas: de 0.01 a 1. ---
MAX_MONTO_MXN=
