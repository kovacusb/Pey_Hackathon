# Aquí solo van los NOMBRES de las variables. Los VALORES se guardan como secretos (Render, Codespaces o .env local). Nunca en el repo.
# En GitHub ya están como secretos del repo (Codespaces y Actions): para actualizarlos, llena .env y corre scripts/cargar_secretos.sh.

# --- pey (portal.mipey.mx → Desarrollador → "Crear API Key"). Solo existe producción: todo cobro es real (pey/02, K03.3). ---
PEY_API_KEY=
# Secreto de firma del webhook: engrane de la llave → "Crear Webhook" con URL https://<tu-dominio>/webhooks/pey (pey/09, K03.5).
PEY_WEBHOOK_SECRET=

# --- Tope de cobro en pesos que impone el servidor (decisión propia, no es límite de pey; K03.7). En pruebas: de 0.01 a 1. ---
MAX_MONTO_MXN=1
# Monto real que se cobra en la demo sin importar el monto del recibo (0 = cobrar el monto real, hasta el tope).
DEMO_COBRO_MXN=0.01

# --- WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → API Setup) ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# App settings → Basic → App Secret. Sirve para verificar la firma X-Hub-Signature-256 de Meta.
WA_APP_SECRET=
# Texto que tú inventas; se pone igual en Meta → WhatsApp → Configuration → Webhook → Verify token.
WA_VERIFY_TOKEN=
WA_API_VERSION=v23.0

# --- Servidor ---
PORT=3000
# Chat de pruebas en /dev y pagos simulados (marcados SIMULACIÓN). 1 = encendido.
DEV_TOOLS=1
DB_PATH=data/pey.sqlite
